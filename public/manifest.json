{
  "manifest_version": 3,
  "name": "Moxxy — закладки карточками",
  "short_name": "Moxxy",
  "version": "0.2.0",
  "description": "Закладки Chrome на весь экран в виде карточек с картинками, описаниями и действиями.",
  "permissions": ["bookmarks", "tabGroups", "storage", "unlimitedStorage", "tabs", "scripting", "favicon"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Открыть Moxxy",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+B" }, "description": "Открыть Moxxy" }
  }
}
